// Black background, logo.png centred.
// If the image is larger than 80 % of the display, it is scaled down.

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

sw = Window.GetWidth();
sh = Window.GetHeight();

logo.image = Image("logo.png");
iw = logo.image.GetWidth();
ih = logo.image.GetHeight();

scale = Math.Min(sw * 0.8 / iw, sh * 0.8 / ih);
if (scale < 1)
    logo.image = logo.image.Scale(iw * scale, ih * scale);

logo.sprite = Sprite(logo.image);
logo.sprite.SetX(sw / 2 - logo.image.GetWidth() / 2);
logo.sprite.SetY(sh / 2 - logo.image.GetHeight() / 2);
logo.sprite.SetZ(10);

// Do not show password/question dialogs and messages
fun message_callback(text) { }
Plymouth.SetMessageFunction(message_callback);
